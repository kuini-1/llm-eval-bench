# Copy to .env and fill in what you use. Never commit .env.
# docker compose reads it automatically. For the CLI, export the variables
# first, e.g. `set -a; . ./.env; set +a`.

# Claude (Opus, Fable). Leave empty to use only local or mock models.
ANTHROPIC_API_KEY=

# DeepSeek, through its OpenAI-compatible API.
DEEPSEEK_API_KEY=

# Config file for the CLI and server when -config isn't given (default bench.yaml).
EVALBENCH_CONFIG=bench.yaml

# Where the web UI's /api requests go (read by next.config.ts at build and dev time).
EVALBENCH_API_URL=http://127.0.0.1:8097
